{
  "name": "post-canvas",
  "version": "0.1.1",
  "description": "Open-source React rich text editor and WYSIWYG editor built on Tiptap, with photo galleries, collages, video and social embeds, and sanitized HTML output.",
  "keywords": [
    "react",
    "rich-text-editor",
    "rich-text",
    "wysiwyg",
    "wysiwyg-editor",
    "editor",
    "text-editor",
    "html-editor",
    "tiptap",
    "prosemirror",
    "react-component",
    "nextjs",
    "markdown",
    "image-gallery",
    "collage",
    "embed",
    "youtube",
    "html-sanitizer",
    "blog",
    "tinymce-alternative"
  ],
  "author": "Saimul Islam",
  "license": "MIT",
  "homepage": "https://postcanvas.saimulislam.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saimulft/post-canvas.git",
    "directory": "package"
  },
  "bugs": {
    "url": "https://github.com/saimulft/post-canvas/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions.d.ts",
      "import": "./dist/extensions.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./vanilla": {
      "types": "./dist/vanilla.d.ts",
      "import": "./dist/vanilla.js"
    },
    "./locales/*": {
      "types": "./dist/locales/*/index.d.ts",
      "import": "./dist/locales/*/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "eslint . && npm run lint:names",
    "lint:names": "ls-lint --config ../.ls-lint.yml --workdir ..",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "tsdown && node scripts/build-css.js",
    "playground": "vite",
    "prepack": "node scripts/prepack.js",
    "check:package": "publint --strict --pack npm && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css ./package.json",
    "size": "size-limit",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-blockquote": "^3.34.0",
    "@tiptap/extension-bold": "^3.34.0",
    "@tiptap/extension-bubble-menu": "^3.34.0",
    "@tiptap/extension-code": "^3.34.0",
    "@tiptap/extension-code-block": "^3.34.0",
    "@tiptap/extension-code-block-lowlight": "^3.34.0",
    "@tiptap/extension-document": "^3.34.0",
    "@tiptap/extension-file-handler": "^3.34.0",
    "@tiptap/extension-floating-menu": "^3.34.0",
    "@tiptap/extension-hard-break": "^3.34.0",
    "@tiptap/extension-heading": "^3.34.0",
    "@tiptap/extension-highlight": "^3.34.0",
    "@tiptap/extension-horizontal-rule": "^3.34.0",
    "@tiptap/extension-italic": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-list": "^3.34.0",
    "@tiptap/extension-mention": "^3.34.0",
    "@tiptap/extension-paragraph": "^3.34.0",
    "@tiptap/extension-strike": "^3.34.0",
    "@tiptap/extension-subscript": "^3.34.0",
    "@tiptap/extension-superscript": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extension-text": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/extension-text-style": "^3.34.0",
    "@tiptap/extension-underline": "^3.34.0",
    "@tiptap/extension-unique-id": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/html": "^3.34.0",
    "@tiptap/markdown": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tiptap/static-renderer": "^3.34.0",
    "@tiptap/suggestion": "^3.34.0",
    "@use-gesture/react": "^10.3.1",
    "highlight.js": "~11.11.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.74.0",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@ls-lint/ls-lint": "^2.3.2",
    "@size-limit/esbuild": "^14.3.0",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "lightningcss": "^1.33.0",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
